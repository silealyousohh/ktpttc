# Hostinger LiteSpeed / Apache Configuration for Node.js
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Allow existing static files to be served directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Forward all other requests to Node.js backend
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>
